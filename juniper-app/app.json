{
  "expo": {
    "name": "Juniper",
    "slug": "juniper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "juniper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.wheredidfranciscogo.juniper",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wheredidfranciscogo.juniper"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F5",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3F5D3E",
          "defaultChannel": "watering"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "wheredidfranciscogo",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5ec95fe-f8c0-478c-834d-4cb9d15837cf"
      }
    }
  }
}
