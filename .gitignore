# Juniper — one repo, three folders. Paths are relative to the project root.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native folders (Continuous Native Generation — never commit these)
/juniper-app/ios/
/juniper-app/android/

# Native signing material — never commit
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# testing
/coverage
juniper-app/coverage/

# Local archive of pre-collapse artefacts (see DECISIONS.md D4)
.archive/
